# Example environment variables (safe to commit).
# Real secrets go in ~/.config/project-secrets/<project>.env (injected via Dev Container --env-file).
# You may also create a local .env for non-secret values used by tooling — never commit .env.

# API / app
# API_BASE_URL=http://localhost:8000
# LOG_LEVEL=INFO

# Cognito (pool/client IDs are not secrets; omit client secrets here)
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-east-1

# AWS (prefer host/container IAM roles; put keys only in project-secrets)
# AWS_REGION=us-east-1
# AWS_PROFILE=
