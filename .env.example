# Copia a .env (nunca lo subas a git). En el PC no hace falta: los valores por defecto sirven.

# --- Servidor (homelab) ---
# APP_ENV=prod                     # desactiva /api/docs y exige APP_JWT_SECRET
# APP_JWT_SECRET=                  # genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_BIND=0.0.0.0                 # escuchar en la red local (por defecto solo 127.0.0.1)
# APP_PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1    # IP del proxy inverso (Caddy/Nginx/Traefik) si usas uno
# APP_CORS_ORIGINS=[]              # solo si sirves el frontend desde otro dominio

# --- Opcional ---
# APP_ACCESS_TOKEN_MINUTES=480     # duración de la sesión
# APP_ADMIN_USERNAME=admin         # solo se usa al crear el primer admin
# APP_ADMIN_PASSWORD=              # vacío = se genera una aleatoria (ver data/credenciales_iniciales.txt)
